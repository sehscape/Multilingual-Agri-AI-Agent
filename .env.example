# =============================================================================
# THREE PROFILES:
#   • LOCAL DEV (CPU)   — keep the stub flags = true, use the lighter models.
#                         Fast, no multi-GB downloads. Voice speaks English.
#   • PRODUCTION (GPU)  — set every USE_STUB_* = false, TTS_ENGINE=parler,
#                         WHISPER_MODEL_ID=openai/whisper-large-v3.
#                         Farmer hears the answer in their own language.
#   • LITE (512 MB host) — set LITE_MODE=true and install requirements-lite.txt.
#                         Typed input only, keyword scheme search, no PyTorch.
#                         Used for the free Render deploy (see DEPLOY.md).
# Copy this file to `.env` and adjust.
# =============================================================================

# ─── LITE mode (free Render deploy) ───────────────────────────────────────────
# true → force a tiny footprint: typed input, keyword scheme search,
#        rule-based answers, English gTTS voice. Overrides the flags below.
LITE_MODE=false

# ─── STT ──────────────────────────────────────────────────────────────────────
WHISPER_MODEL_ID=openai/whisper-large-v3
# Local dev override (lighter, CPU-feasible):
# WHISPER_MODEL_ID=openai/whisper-tiny

# ─── Translation (IndicTrans2) ─────────────────────────────────────────────────
TRANSLATION_MODEL_INDIC_EN=ai4bharat/indictrans2-indic-en-1B
TRANSLATION_MODEL_EN_INDIC=ai4bharat/indictrans2-en-indic-1B

# ─── LLM ──────────────────────────────────────────────────────────────────────
LLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL_ID=BAAI/bge-m3
# Local dev override:
# EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ─── TTS ──────────────────────────────────────────────────────────────────────
TTS_MODEL_ID=ai4bharat/indic-parler-tts
# Voice engine:  gtts (lightweight, CPU, needs internet — dev default)
#                parler (production, GPU) | stub (no audio)
TTS_ENGINE=gtts

# ─── Runtime mode / stubs ──────────────────────────────────────────────────────
# Dev defaults keep heavy models off. Set all to false for production.
USE_STUB_TRANSLATION=true    # true = skip IndicTrans2 (~4GB); answer stays English
USE_STUB_LLM=true            # true = rule-based StubLLM (no HF token needed)
USE_STUB_RAG=false           # false = use the real FAISS scheme index

# ─── Hugging Face ─────────────────────────────────────────────────────────────
HF_TOKEN=your_huggingface_token_here
# true  → use HF Inference API (no local GPU needed, good for dev)
# false → load model locally (requires GPU)
USE_HF_INFERENCE_API=true

# ─── Weather ──────────────────────────────────────────────────────────────────
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
GEOCODING_API_URL=https://geocoding-api.open-meteo.com/v1/search

# ─── RAG ──────────────────────────────────────────────────────────────────────
VECTORSTORE_PATH=data/vectorstore
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
# Minimum retrieval relevance (0-1); below this the scheme tool says
# "insufficient information" instead of guessing.
RAG_MIN_SCORE=0.30
# Scheme search backend: faiss (semantic, needs torch) | bm25 (keyword, no torch)
# LITE_MODE forces bm25.
RAG_BACKEND=faiss

# ─── LLM Generation ───────────────────────────────────────────────────────────
MAX_NEW_TOKENS=512
TEMPERATURE=0.3

# ─── App ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEV_MODE=true
